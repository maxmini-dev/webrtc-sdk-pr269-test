m144_release build fixups on top of webrtc-sdk/webrtc-build patches

The `webrtc-sdk/webrtc-build` repo's standard `android_prefixed` patches
(`add_license_dav1d.patch`, `android_webrtc_version.patch`, `fix_mocks.patch`,
`jni_prefix.patch`) are authored against `main`. When applied to the
`m144_release` branch (where PR #269 lives), one hunk of `jni_prefix.patch`
fails to apply because `sdk/android/BUILD.gn` picked up new `generate_jni`
targets between `main` and `m144_release`. This patch adds the missing
`package_prefix = android_package_prefix` lines to the two blocks that
drifted, and provides the `WebrtcBuildVersion.java` stub that
`android_webrtc_version.patch` expects to already exist.

Apply on top of the four webrtc-sdk/webrtc-build patches, before running
`tools_webrtc/android/build_aar.py`.

--- a/sdk/android/BUILD.gn
+++ b/sdk/android/BUILD.gn
@@ -1613,11 +1613,13 @@
       "api/org/webrtc/audio/AudioProcessingMode.java",
       "api/org/webrtc/audio/AudioProcessingState.java",
     ]
     namespace = "webrtc::jni"
+    package_prefix = android_package_prefix
   }

   generate_jni("generated_java_audio_jni") {
     sources = [ "api/org/webrtc/audio/JavaAudioDeviceModule.java" ]
     namespace = "webrtc::jni"
+    package_prefix = android_package_prefix
   }

   generate_jni("generated_builtin_audio_codecs_jni") {
--- /dev/null
+++ b/sdk/android/api/org/webrtc/WebrtcBuildVersion.java
@@ -0,0 +1,7 @@
+package org.webrtc;
+public interface WebrtcBuildVersion {
+    public static final String webrtc_branch = "m144_release";
+    public static final String webrtc_commit = "2ce4de3c52818b3e08e3c5d8be6220d9ecb4a368";
+    public static final String webrtc_revision = "144.7559.09-pr269";
+    public static final String maint_version = "0";
+}
