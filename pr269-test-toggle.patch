     testImplementation libs.junit
     androidTestImplementation libs.androidx.test.core
diff --git a/sample-app-common/src/main/java/io/livekit/android/sample/CallViewModel.kt b/sample-app-common/src/main/java/io/livekit/android/sample/CallViewModel.kt
index b218278..73d9e4f 100644
--- a/sample-app-common/src/main/java/io/livekit/android/sample/CallViewModel.kt
+++ b/sample-app-common/src/main/java/io/livekit/android/sample/CallViewModel.kt
@@ -75,6 +75,8 @@ class CallViewModel(
     val e2eeKey: String? = "",
     val audioProcessorOptions: AudioProcessorOptions? = null,
     val stressTest: StressTest = StressTest.None,
+    // webrtc-sdk PR #269: when false, mute leaves AudioRecord running (mute inside the engine).
+    val stopRecordingOnMute: Boolean = true,
 ) : AndroidViewModel(application) {
 
     private fun getE2EEOptions(): E2EEOptions? {
@@ -100,6 +102,10 @@ class CallViewModel(
         overrides = LiveKitOverrides(
             audioOptions = AudioOptions(
                 audioProcessorOptions = audioProcessorOptions,
+                javaAudioDeviceModuleCustomizer = { builder ->
+                    LKLog.i { "PR269: JavaAudioDeviceModule.setStopRecordingOnMute($stopRecordingOnMute)" }
+                    builder.setStopRecordingOnMute(stopRecordingOnMute)
+                },
             ),
         ),
     )
@@ -362,6 +368,11 @@ class CallViewModel(
     fun setMicEnabled(enabled: Boolean) {
         viewModelScope.launch(Dispatchers.IO) {
             room.localParticipant.setMicrophoneEnabled(enabled)
+            // webrtc-sdk PR #269: exercise the ADM mute path so stopRecordingOnMute matters.
+            // Without this, setMicrophoneEnabled only sets track.enabled=false and never
+            // touches AudioDeviceModule.setMicrophoneMute — AudioRecord always stays open.
+            LKLog.i { "PR269: room.setMicrophoneMute(${!enabled})" }
+            room.setMicrophoneMute(!enabled)
         }
     }
 
