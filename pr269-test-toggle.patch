         private const val PREFERENCES_KEY_E2EE_KEY = "e2ee_key"
+        private const val PREFERENCES_KEY_STOP_ON_MUTE = "stop_recording_on_mute"
 
         const val URL = BuildConfig.DEFAULT_URL
         const val TOKEN = BuildConfig.DEFAULT_TOKEN
